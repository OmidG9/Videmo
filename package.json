{
  "name": "videmo",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted video library with SQLite storage, local auth and a custom player.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build",
    "seed": "tsx scripts/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:reset": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true});console.log('data/ removed — next run recreates it')\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "geist": "^1.7.2",
    "next": "16.2.4",
    "next-auth": "^4.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
